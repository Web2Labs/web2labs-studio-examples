{
  "youtube_no_music": {
    "preset": "youtube",
    "configuration": {
      "musicEnabled": false,
      "shortsConfig": { "amount": 5, "minLength": 20, "maxLength": 60 }
    }
  },
  "podcast_heavy_subtitles": {
    "preset": "podcast",
    "configuration": {
      "subtitleConfig": {
        "fontSizePreset": "large",
        "enableHighlight": true
      }
    }
  }
}
